{
  "expo": {
    "name": "GT Network",
    "slug": "gt-network",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF8EE"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.gtnetwork.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF8EE"
      },
      "package": "com.gtnetwork.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ]
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-image-picker"
    ],
    "owner": "neelaakhil12",
    "extra": {
      "eas": {
        "projectId": "b9282fb3-3e05-4484-9125-7ec714fcfd3f"
      }
    }
  }
}
