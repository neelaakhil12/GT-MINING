{
  "expo": {
    "name": "GT Network",
    "slug": "gt-network",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF8EE"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.gtnetwork.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF8EE"
      },
      "package": "com.gtnetwork.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "0ce96532-48cd-490b-84c7-fa7ff61e34b7"
      }
    },
    "owner": "student222"
  }
}
